# --- Retell ---
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxx
# The public HTTPS URL this server is reachable on (no trailing slash)
PUBLIC_BASE_URL=https://voice.dbsgroup.io
# Filled in after running `npm run setup-agent`
RETELL_AGENT_ID=
# Optional: voice and model for the agent (pick a British voice in the Retell dashboard)
RETELL_VOICE_ID=11labs-Adrian
RETELL_MODEL=

# --- Server ---
PORT=8080
# Dashboard login sessions: a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Only for local testing. Never set this in production.
SKIP_SIGNATURE_CHECK=false

# --- Email notifications (Resend.com) ---
RESEND_API_KEY=
NOTIFY_FROM=DBS Voice Assistant <assistant@dbsgroup.io>

# --- Google Calendar (service account) ---
# Create a service account in Google Cloud, enable the Calendar API, download the JSON key,
# then share each client's calendar with the service account email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with \n for newlines
GOOGLE_PRIVATE_KEY=

# --- Phone numbers: auto-import UK numbers from your SIP trunk into Retell (optional) ---
RETELL_SIP_TERMINATION_URI=
RETELL_SIP_USERNAME=
RETELL_SIP_PASSWORD=

# --- "Connect Google Calendar" button (Google Cloud OAuth client, type Web application) ---
# Authorised redirect URI: https://<your-domain>/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Self sign-up with card payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT=voice_minutes

# --- Where DBS gets alerts about sign-ups, cancellations and failed payments ---
ADMIN_EMAIL=

# Landing page "call the demo" number (optional)
DEMO_PHONE_NUMBER=
